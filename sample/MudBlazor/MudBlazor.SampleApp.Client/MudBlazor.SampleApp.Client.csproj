<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
		<StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
		<BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
		<RootNamespace>MudBlazor.SampleApp.Client</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.*" />
		<PackageReference Include="MudBlazor" Version="9.5.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\MudBlazor.SampleApp.Shared\MudBlazor.SampleApp.Shared.csproj" />
	</ItemGroup>

</Project>
